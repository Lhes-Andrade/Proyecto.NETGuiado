@model List<TiendaWebAndrade.Models.Producto> 
<h2 class="mb-4">Lista de Productos</h2>

<a class="btn btn-success mb-3" href="/Producto/Create">+ Nuevo Producto</a>
<div class="table-reponsive">
<table class="table table-striped table-hover table-bordered align-middlde">
    <thead class="table-dark">
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Nombre</th>
            <th scope="col">Precio</th>
            <th scope="col">Stock</th>
            <th scope="col">Categoria</th>
            <th scope="col" class="text-center text-nowrap">Acciones</th>
        </tr>
    </thead>

    <tbdoy>
        <!-- Busca los item he hemos creado en la List(Producto) -->
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Precio</td>
                <td>@item.Stock</td>
                <td>@item.Categoria?.Nombre</td>
                <td>
                    <a class="btn btn-warning" href="/Producto/Edit/@item.Id">Editar</a>
                    <a class="btn btn-danger" href="/Producto/Delete/@item.Id">Eliminar</a>
                </td>

            </tr>
        }
    </tbdoy>
</table>
</div>
@model List<TiendaWebAndrade.Models.Categoria>

<h2>Lista de Categorías</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>
                    @if (item.Estado == "A")
                    {
                        <span class="text-success">Activa</span>    
                    } else
                    {
                        <span class="text-danger">Inactivo</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
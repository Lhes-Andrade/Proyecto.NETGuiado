@model List<TiendaWebAndrade.Models.Usuario>

<h2>Lista de Usuarios</h2>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Celular</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Correo</td>
                <td>@item.Rol</td>
                <td>@item.Celular</td>
                <td>
                    @if (item.Estado == "A")
                    {
                        <span class="text-success">Activa</span>
                    }
                    else
                    {
                        <span class="text-danger">Inactivo</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
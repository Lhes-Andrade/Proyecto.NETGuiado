@model TiendaWebAndrade.Models.Usuario

<h2>Crear Usuario</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Correo</label>
        <input asp-for="Correo" type="email" class="form-control" />
    </div>
    <div class="form-group">
        <label>Rol</label>
        <select asp-for="Rol" class="form-control">
            <option value="Administrador">Administrador</option>
            <option value="Cajero">Cajero</option>
            <option value="Bodeguero">Bodeguero</option>
            <option value="Cliente">Cliente</option>
        </select>
    </div>
    <div class="form-group">
        <label>Celular</label>
        <input asp-for="Celular" class="form-control" />
        <span asp-validation-for="Celular" class="text-danger"></span>
    </div>
    <hr />
    <button class="btn btn-success">Guardar</button>
    <a class="btn btn-secondary" href="/Usuario">Cancelar</a>
</form>